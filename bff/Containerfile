ARG BASE_IMAGE="registry.access.redhat.com/ubi9/nodejs-22:latest"
ARG HELM_VERSION="3.17.3"

# Build stage
FROM ${BASE_IMAGE} AS builder

COPY --chown=default:root package*.json ./
RUN npm ci

COPY --chown=default:root . .
RUN npm run build

# Helm binary stage
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest AS helm
ARG HELM_VERSION
USER root
RUN microdnf install -y tar gzip && \
    curl -fsSL "https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz" \
      | tar -xz --strip-components=1 -C /usr/local/bin linux-amd64/helm && \
    chmod +x /usr/local/bin/helm

# Production stage
FROM ${BASE_IMAGE}

COPY --from=helm --chown=1001:0 /usr/local/bin/helm /usr/local/bin/helm
COPY --from=builder --chown=1001:0 /opt/app-root/src/dist ./dist
COPY --from=builder --chown=1001:0 /opt/app-root/src/node_modules ./node_modules
COPY --from=builder --chown=1001:0 /opt/app-root/src/package.json ./

EXPOSE 3000

USER 1001:0

CMD ["node", "dist/server.js"]
